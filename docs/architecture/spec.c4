specification {
  element person {
    title "Person"
    notation "Person"
    style { shape person; color green }
  }

  element system {
    title "System"
    notation "Software System"
    style { color primary }
  }

  element container {
    title "Container"
    notation "Container"
    style { shape component; color primary }
  }

  element external-system {
    title "External System"
    notation "External System"
    style { color muted }
  }

  // Помечает блоки (элементы), сознательно отложенные
  // на последующие итерации разработки.
  // Визуальное оформление задаётся правилами style в views.c4.
  tag deferred

  // Вид связи для взаимодействий, отложенных
  // на последующие итерации разработки.
  // Стиль задаётся по умолчанию спецификацией вида.
  relationship deferred {
    description "Взаимодействие, сознательно отложенное на последующие итерации разработки."
    color muted; line dashed; head dot
  }
}