model {
  extend pig-console-shell {
    ui-shell = container "UI Shell" {
    summary "Основной интерфейс пользователя, композитор и управление layout'ом окон"
    description """
      Основная точка взаимодействия пользователя с остальными компонентами.
      Реализует практически все аспекты Wayland-композитора поверх внешней
      библиотеки (например, smithay): поверхности, рендеринг, seat-ввод,
      приём ivi-поверхностей от клиентов.
      Управляет layout'ом запускаемых приложений (игра, браузер, терминал),
      обрабатывает навигацию с геймпада, запускает браузер и терминал,
      отображает каталог и библиотеку игр.
      Внутренняя структура (в т.ч. Compositor Core) детализируется
      на слое Components.
    """
    technology "Rust / smithay (Wayland)"

    -> game-launcher "запрашивает запуск игры" { technology "IPC" }
    -> game-library "читает список игр и настройки" { technology "IPC" }
    -> browser "запускает и управляет окном" { technology "Wayland IVI-shell" }
    -> terminal "запускает и управляет окном" { technology "Wayland IVI-shell" }
    -> package-manager "запускает обновления" {
      technology "IPC"
      description "Установка обновлений игр и системы целиком управляется пользователем и инициируется из UI Shell."
    }
    package-manager -> it "уведомляет об обновлениях" {
      technology "IPC"
      description "Package/Update Manager оповещает UI Shell о наличии обновлений игр и нижележащей системы."
    }
  }

  game-launcher = container "Game Launcher" {
    summary "Запуск установленных игр с учётом их прав"
    description """
      Запускает установленную игру с учётом настроек её прав.
      Пакет игры представляет собой squash-fs образ: монтирует его,
      читает запрашиваемые разрешения из манифеста (доступ в сеть,
      чтение/запись в общие для игр директории и т.п.), учитывает
      пользовательские разрешения, перетирающие требования манифеста,
      и запускает приложение самой игры.
      Также предоставляет интерфейс получения данных из манифеста
      пакета для других подсистем.
      Монтирование squashfs требует повышения привилегий, поэтому этот
      функционал вынесен в независимый процесс с минимальным функционалом
      (SUID-бинарник).
    """
    technology "Rust / squashfs / SUID-процесс"

    <-> game-library "обменивается данными пакета, прав и настроек игры" { technology "IPC" }
    -> games "запускает игровое приложение" { technology "Spawn / Wayland" }
  }

  package-manager = container "Package/Update Manager" {
    summary "Менеджер игровых пакетов и системных обновлений"
    description """
      Получает список доступных игр (метаданные из игрового репозитория),
      скачивает игры, детектирует наличие обновлений для установленных игр
      (взаимодействуя с Game Library).
      Также умеет узнавать о наличии системных обновлений дистрибутива
      Linux и запускать их через PackageKit.
    """
    technology "Rust / HTTP / PackageKit"

    -> game-repository "ищет и скачивает игры" { technology "HTTP API" }
    <-> game-library "устанавливает, обновляет, удаляет игры" { technology "IPC" }
    -> packagekit "проверяет и запускает системные обновления" { technology "D-Bus" }
  }

  game-library = container "Game Library" {
    summary "Владелец установленных игр, их ресурсов и настроек"
    description """
      В значительной части представляет собой базу данных на лёгкой СУБД
      (например, SQLite). Владеет установленными играми и их ресурсами —
      файлами сохранений, сделанными игроком скриншотами и т.п. Позволяет
      независимо удалять игру и её ресурсы: например, удалить игру из-за
      нехватки места под другую, сохранив настройки и сохранения, чтобы
      позже скачать и запустить её снова.
      Предоставляет интерфейс хранения настроек, ассоциированных с игрой,
      используемый другими компонентами (например, флаг «любимая игра»,
      определяющий порядок отображения списка игр в UI-оболочке).
    """
    technology "SQLite (лёгкая СУБД)"
  }
}

games -> pig-console-shell.ui-shell "создаёт ivi-поверхность" { technology "Wayland IVI-shell" }
browser -> pig-console-shell.ui-shell "создаёт ivi-поверхность" { technology "Wayland IVI-shell" }
terminal -> pig-console-shell.ui-shell "создаёт ivi-поверхность" { technology "Wayland IVI-shell" }
}