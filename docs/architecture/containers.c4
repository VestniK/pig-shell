model {
  extend pig-console-shell {
    pig-shell = container "Pig Shell" {
      summary "Приложение-композитор и основной GUI системы"
      description """
        Отдельное приложение, реализующее практически все аспекты
        Wayland-композитора поверх внешней библиотеки (например, smithay):
        поверхности, рендеринг, seat-ввод, приём ivi-поверхностей от клиентов.
        Управляет layout'ом окон запущенных приложений (игра, браузер, терминал)
        и является основным GUI системы: отображает каталог и библиотеку игр,
        обрабатывает навигацию с геймпада, запускает браузер и терминал.
        Сама по себе не содержит сложной логики: управление библиотекой игр,
        обновлениями игр и нижележащей системы, а также запуск игры
        делегирует приложению **pig-library**. Внутренняя структура
        (в т.ч. Compositor Core, Layout Manager, Gamepad Input) детализируется
        на слое Components.
      """
      technology "Rust / smithay (Wayland)"

      -> browser "запускает и управляет окном" { technology "Wayland IVI-shell" }
      -> terminal "запускает и управляет окном" { technology "Wayland IVI-shell" }
      <-> pig-library "запрашивает данные и делегирует действия" {
        technology "D-Bus (user session)"
        description """
          Единственный канал сложной логики. Через него pig-shell:
          — получает список установленных игр, список доступных игр в репозитории
            и факт наличия обновлений (для отображения в UI);
          — делегирует выполнение действий, запрошенных пользователем:
            запуск игры, установка новой игры, удаление старой,
            запуск обновлений игр и нижележащей системы.
          pig-library — провайдер данных и исполнитель действий для pig-shell.
        """
      }
    }

    pig-library = container "Pig Library" {
      summary "D-Bus сервис управления библиотекой игр, обновлениями и запуском"
      description """
        Сервис, запускающийся в пользовательской systemd-сессии и инкапсулирующий
        всю сложную логику управления играми и обновлениями:
          — владеет установленными играми и их ресурсами (сохранения, скриншоты),
            предоставляет список установленных игр и их настроек;
          — взаимодействует с внешним репозиторием игр: поиск, получение метаданных,
            скачивание;
          — детектирует и выполняет обновления установленных игр и нижележащей
            системы (через PackageKit);
          — запускает игры, делегируя низкоуровневую работу с пакетом
            (монтирование, изоляция) утилите **pig-pkg**.
        Является провайдером данных и исполнителем действий для pig-shell:
        pig-shell не общается с репозиторием, PackageKit или pig-pkg напрямую.
        Внутренняя структура (хранилище игр, менеджер пакетов, детектор обновлений)
        детализируется на слое Components. То, что персистентные данные хранятся
        в какой-либо лёгкой СУБД, является внутренним нюансом реализации: эта БД
        используется исключительно этим приложением и никем больше.
      """
      technology "Rust / D-Bus (systemd user session)"

      -> game-repository "ищет и скачивает игры" { technology "HTTP API" }
      -> packagekit "проверяет и запускает системные обновления" { technology "D-Bus" }
      -> pig-pkg "запускает игру из пакета с изоляцией" { technology "CLI / Spawn" }
    }

    pig-pkg = container "Pig Pkg" {
      summary "SUID-утилита для запуска игры из пакета в настроенной изоляции"
      description """
        Низкоуровневая CLI-утилита с SUID-битом, работающая с отдельным игровым
        пакетом. Выполняет минимальный затребованный объём действий:
          — монтирует squash-fs образ пакета;
          — читает запрашиваемые разрешения из манифеста (доступ в сеть,
            чтение/запись в общие для игр директории и т.п.);
          — учитывает пользовательские настройки разрешений, перетирающие
            требования манифеста;
          — настраивает изоляцию (sandbox) на основании результирующих разрешений;
          — понижает привилегии внутри настроенной изоляции и делает exec
            приложения игры из пакета.
        Не содержит бизнес-логики библиотеки игр или обновлений; вызывается
        приложением **pig-library** для конкретного пакета.
      """
      technology "Rust / squashfs / SUID / Linux namespaces"

      -> games "exec приложения игры с изоляцией" { technology "Spawn / Wayland" }
    }
  }

  games -> pig-console-shell.pig-shell "создаёт ivi-поверхность" { technology "Wayland IVI-shell" }
  browser -> pig-console-shell.pig-shell "создаёт ivi-поверхность" { technology "Wayland IVI-shell" }
  terminal -> pig-console-shell.pig-shell "создаёт ivi-поверхность" { technology "Wayland IVI-shell" }
}