views {
  view context {
    title "Context — Pig Console Shell"
    description """
      Слой Context (C4, уровень 1): система **Pig Console Shell**,
      её пользователи и внешние зависимости.
    """

    include *

    autoLayout LeftRight
  }

  view containers of pig-console-shell {
    title "Containers — Pig Console Shell"
    description """
      Слой Container (C4, уровень 2): внутренняя структура системы
      **Pig Console Shell** и её взаимодействие с внешними системами.
    """

    include *

    autoLayout TopBottom
  }
}