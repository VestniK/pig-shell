model {
  player = person "Игрок" {
    summary "Управляет консолью через геймпад"
    description """
      Основной пользователь консоли.
      Взаимодействует с системой преимущественно через геймпад:
      навигация по интерфейсу оболочки, запуск игр и браузера.
    """
  }

  administrator = person "Администратор" {
    summary "Администрирует систему через терминал"
    description """
      Опытный пользователь, выполняющий задачи администрирования.
      Работает в том числе с терминалом, поэтому требует клавиатуру.
    """
  }

  pig-console-shell = system "Pig Console Shell" {
    summary "UI-оболочка для Raspberry Pi на базе Wayland IVI shell"
    description """
      Композитор и оболочка, превращающие Raspberry Pi в игровую консоль.
      Построена на протоколе Wayland IVI shell и библиотеке композитора.
      Полностью определяет раскладку окон трёх типов приложений:
      игра, браузер и терминал.

      Название **Pig** — сокращение от *Pi Games* с игрой слов
      (похоже на англ. *pig*, «свинья»). Маскот проекта — свинка,
      играющая в компьютерные игры.
    """
    technology "Rust / Wayland IVI-shell"
  }

  games = external-system "Игры" {
    summary "Игровые приложения, запускаемые оболочкой"
    description """
      Внешние игровые приложения, которые оболочка запускает и размещает
      на экране как полноэкранные поверхности. Устанавливаются через
      собственный менеджер игровых пакетов оболочки.
    """
    technology "Wayland-клиент"
  }

  game-repository = external-system "Игровой репозиторий" {
    summary "Источник игровых пакетов для поиска и установки"
    description """
      Внешний каталог игр, с которым оболочка взаимодействует через
      собственный менеджер игровых пакетов: поиск, получение метаданных,
      скачивание, обновление и удаление игр.
    """
    technology "HTTP API"
  }

  browser = external-system "Браузер" {
    summary "Веб-браузер как одно из окон оболочки"
    description """
      Браузер, запускаемый оболочкой; показывается как окно
      в одном из возможных layout'ов.

      Реальный используемый браузер может быть любым,
      поддерживающим протокол Wayland. Он берётся из дистрибутива
      поверх которого запущена оболочка.

      При наличии нескольких браузеров в системе может требоваться
      настройка задающая какой браузер использовать.

      Вероятно взаимодействие с браузеом комфортней будет делать с
      помощью клавиатуры и мышки, чем с помощью gamepad'а.
    """
    technology "Wayland-клиент"
  }

  terminal = external-system "Терминал" {
    summary "Терминал для администрирования"
    description """
      Терминальный эмулятор, используемый администратором.
      Окно, требующее клавиатурного ввода.
    """
    technology "Wayland-клиент"
  }

  packagekit = external-system "PackageKit" {
    summary "Системный менеджер пакетов дистрибутива Linux"
    description """
      Системный сервис управления пакетами ОС, поверх которой работает
      консоль. Используется оболочкой для проверки наличия и запуска
      системных обновлений.
    """
    technology "D-Bus API"
  }

  player -> pig-console-shell "управляет" {
    technology "Gamepad"
    description """
      Навигация по интерфейсу оболочки с помощью геймпада:
      запуск игр и приложений, поиск, установка и удаление игр,
      управление их настройками, просмотр списка установленных игр.
    """
  }

  administrator -> pig-console-shell "вводит команды" {
    technology "Клавиатура"
    description "Клавиатурный ввод, направляемый в терминал."
  }
}