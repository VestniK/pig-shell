model {
  player = person "Игрок" {
    summary "Управляет консолью через геймпад"
    description """
      Основной пользователь консоли.
      Взаимодействует с системой преимущественно через геймпад:
      навигация по интерфейсу оболочки, запуск игр и браузера.
    """
  }

  administrator = person "Администратор" {
    summary "Администрирует систему через терминал"
    description """
      Опытный пользователь, выполняющий задачи администрирования.
      Работает в том числе с терминалом, поэтому требует клавиатуру.
    """
  }

  pig-console-shell = system "Pig Console Shell" {
    summary "UI-оболочка для Raspberry Pi на базе Wayland IVI shell"
    description """
      Композитор и оболочка, превращающие Raspberry Pi в игровую консоль.
      Построена на протоколе Wayland IVI shell и библиотеке композитора.
      Полностью определяет раскладку окон трёх типов приложений:
      игра, браузер и терминал.

      Название **Pig** — сокращение от *Pi Games* с игрой слов
      (похоже на англ. *pig*, «свинья»). Маскот проекта — свинка,
      играющая в компьютерные игры.
    """
    technology "Rust / Wayland IVI-shell"
  }

  games = external-system "Игры" {
    summary "Игровые приложения, запускаемые оболочкой"
    description """
      Внешние игровые приложения, которые оболочка запускает и размещает
      на экране как полноэкранные поверхности. Устанавливаются через
      собственный менеджер игровых пакетов оболочки.
    """
    technology "Wayland-клиент"
  }

  game-repository = external-system "Игровой репозиторий" {
    summary "Источник игровых пакетов для поиска и установки"
    description """
      Внешний каталог игр, с которым система взаимодействует через
      собственный менеджер игровых пакетов: поиск, получение метаданных,
      скачивание, обновление и удаление игр.
    """
    technology "HTTP API"
  }

  browser = external-system "Браузер" {
    summary "Веб-браузер как одно из окон оболочки"
    description """
      Браузер, запускаемый оболочкой; показывается как окно
      в одном из возможных layout'ов.

      Реальный используемый браузер может быть любым,
      поддерживающим протокол Wayland. Он берётся из дистрибутива
      поверх которого запущена оболочка.

      При наличии нескольких браузеров в системе может требоваться
      настройка задающая какой браузер использовать.

      В первой итерации проекта взаимодействие с браузером предполагает
      использование клавиатуры и мышки. Управление браузером с помощью
      gamepad'а — задача последующих итераций.
    """
    technology "Wayland-клиент"
  }

  terminal = external-system "Терминал" {
    summary "Терминал для администрирования"
    description """
      Терминальный эмулятор, используемый администратором.
      Окно, требующее клавиатурного ввода.
    """
    technology "Wayland-клиент"
  }

  packagekit = external-system "PackageKit" {
    summary "Системный менеджер пакетов дистрибутива Linux"
    description """
      Системный сервис управления пакетами ОС, поверх которой работает
      консоль. Используется системой для проверки наличия и запуска
      системных обновлений. Через него же выполняются обновления
      собственных компонентов консоли (Pig Shell, Pig Library, Pig Pkg),
      распространяемых в виде системных пакетов дистрибутива.
    """
    technology "D-Bus API"
  }

  pipewire = external-system "PipeWire" {
    summary "Звуковой сервер нижележащей ОС"
    description """
      Аудиосервер дистрибутива Linux, поверх которого работает консоль.
      Является контрактом, на который могут рассчитывать игры:
      игры выводят звук напрямую через PipeWire.
      Взаимодействие самого pig со звуком — часть Pig Shell;
      звуковые эффекты UI отложены на последующие итерации.
    """
    technology "PipeWire API"
  }

  network-manager = external-system "NetworkManager" {
    summary "Системный менеджер сети дистрибутива Linux"
    description """
      Системный сервис управления сетевыми подключениями.
      В первой итерации настройка сети выполняется администратором
      через терминал средствами CLI/TUI NetworkManager (nmcli/nmtui).
      UI-фронтенд настройки сети в Pig Shell — задача
      последующих итераций.
    """
    technology "D-Bus API"
  }

  systemd-logind = external-system "systemd-logind" {
    summary "Системный сервис управления сессиями и питанием"
    description """
      Системный сервис, через который оболочка выполняет
      выключение и перезагрузку устройства.
    """
    technology "D-Bus API"
  }

  player -> pig-console-shell "управляет" {
    technology "Gamepad"
    description """
      Навигация по интерфейсу оболочки с помощью геймпада:
      запуск игр и приложений, поиск, установка и удаление игр,
      управление их настройками, просмотр списка установленных игр.
    """
  }

  administrator -> pig-console-shell "вводит команды" {
    technology "Клавиатура"
    description "Клавиатурный ввод, направляемый в терминал."
  }

  pig-console-shell <-> games "запускает и управляет окнами" {
    technology "Wayland IVI-shell"
    description "Оболочка запускает игры и управляет их раскладкой; игры создают ivi-поверхности."
  }

  pig-console-shell -> game-repository "ищет и получает игровые пакеты" {
    technology "HTTP API"
    description "Поиск, получение метаданных, скачивание, обновление и удаление игр."
  }

  pig-console-shell -> browser "запускает и управляет окном" {
    technology "Wayland IVI-shell"
  }

  pig-console-shell -> terminal "запускает и управляет окном" {
    technology "Wayland IVI-shell"
  }

  pig-console-shell -> packagekit "проверяет и запускает системные обновления" {
    technology "D-Bus"
  }

  pig-console-shell -> systemd-logind "выключает и перезагружает устройство" {
    technology "D-Bus"
  }

  pig-console-shell -[deferred]-> pipewire "выводит звук интерфейса" {
    technology "PipeWire API"
    description "Звуковые эффекты UI оболочки — задача последующих итераций."
  }

  pig-console-shell -[deferred]-> network-manager "предоставляет UI настройки сети" {
    technology "D-Bus"
    description """
      UI-фронтенд к NetworkManager — задача последующих итераций.
      В первой итерации сеть настраивается администратором
      через терминал (nmcli/nmtui).
    """
  }

  games -> pipewire "выводит звук" {
    technology "PipeWire API"
    description "Контракт на звуковой сервер: игры выводят звук напрямую через PipeWire."
  }
}